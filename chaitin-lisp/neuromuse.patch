+/* ------------------------------------------------------------------ */
+/* floating-point extension (neuromuse)                               */
+/* ------------------------------------------------------------------ */
+
+long mk_flo(double v) /* make a floating-point number */
+{
+ long a;
+ a = cons(nil,nil); /* get an empty node */
+ car[a] = cdr[a] = a; /* so that car & cdr of atom = atom */
+ atom[a] = 1;
+ flo[a] = 1;
+ fval[a] = v;
+ /* not on object list: evaluates to itself */
+ return a;
+}
+
+/* is list of characters (in reverse order) a floating-point literal ? */
+/* if so, leaves its value in fval[0] and returns 1 */
+long float_word(long x)
+{
+ char buf[64], *end;
+ long p, n = 0, digit = 0;
+ for (p = x; p != nil; p = cdr[p]) {
+    long c = car[p];
+    if (c == 0 || strchr("0123456789.eE+-",(int) c) == NULL) return 0;
+    if (c >= '0' && c <= '9') digit = 1;
+    n++;
+ }
+ if (!digit || n >= (long) sizeof(buf)) return 0;
+ buf[n] = '\0';
+ for (p = x; p != nil; p = cdr[p]) buf[--n] = (char) car[p];
+ fval[0] = strtod(buf,&end);
+ return *end == '\0';
+}
+
+/* value of reversed list of decimal digits */
+static double digits_val(long x)
+{
+ if (x == nil) return 0.0;
+ return (car[x] - '0') + 10.0 * digits_val(cdr[x]);
+}
+
+double dval(long x) /* value of number (integer or float) as a double */
+{
+ if (flo[x]) return fval[x];
+ if (numb[x]) return digits_val(pname[x]);
+ return 0.0; /* non-number is zero, as in nmb */
+}
+
+void flo_str(long x, char *buf) /* print representation of a float */
+{
+ sprintf(buf,"%.10g",fval[x]);
+ /* make sure it reads back as a float, not as an integer */
+ if (strpbrk(buf,".eEni") == NULL) strcat(buf,".0");
+}
+
+long mk_int(double v) /* make integer atom from nonnegative double */
+{
+ unsigned long long n = (unsigned long long) v;
+ long digits = nil, last = nil, d;
+ /* digits in reverse order: least significant first */
+ while (n > 0) {
+    d = cons('0' + (long)(n % 10), nil);
+    if (digits == nil) digits = d; else cdr[last] = d;
+    last = d;
+    n /= 10;
+ }
+ return mk_numb(digits);
+}
